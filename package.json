{
  "name": "triform",
  "version": "1.0.0",
  "description": "Convenience store product review backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
